# Azure AD (IDaaS) - reemplazar con tus valores del tenant
AZURE_TENANT_ID=TU-TENANT-ID
AZURE_CLIENT_ID=TU-CLIENT-ID
AZURE_ISSUER_URI=https://login.microsoftonline.com/TU-TENANT-ID/v2.0
AZURE_API_AUDIENCE=api://TU-CLIENT-ID

# CORS (frontend Angular)
CORS_ORIGINS=http://localhost:4200

# Microservicios (local)
ORDERS_SERVICE_URL=http://localhost:8081
PRODUCTS_SERVICE_URL=http://localhost:8082

# Base de datos cloud (perfil cloud)
DB_URL=jdbc:postgresql://localhost:5432/pedidos360
DB_USER=pedidos360
DB_PASSWORD=changeme
